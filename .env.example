# Local or pipeline-generated secrets (never commit real .env).
# Bitbucket repository variables for deploy-agent: see README.md → "Bitbucket: deploy-agent".

POSTGRES_USER=sre
POSTGRES_DB=sre_agent
POSTGRES_PASSWORD=change-me
# Optional override if DB is remote:
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432

AGENT_PORT=8080
LOG_LEVEL=INFO

# Optional: if set, POST /hooks/grafana, /events/recent and /events/{id}/rca/rerun
# require header X-Webhook-Token: <same value>. Strongly recommended in production —
# the agent logs a WARNING on startup when this is empty.
WEBHOOK_SECRET=
# Async psycopg pool (max connections). Increase under sustained webhook load.
# DB_POOL_MAX_SIZE=10

# Ollama from **ai-model** (`deploy-ollama`, project **ai_model_ollama**). Agent joins external network **ai_model_ollama_default**.
OLLAMA_HOST=http://ollama:11434
# Pull the same tag you deployed in **ai-model** (`ollama pull …`).
OLLAMA_MODEL=llama3.2
# RCA text via POST …/api/chat (runs after Loki enrichment; stored under rca_ollama in DB).
OLLAMA_RCA_ENABLED=true
# Optional sampling controls for POST /api/chat (omit both to use Ollama server defaults). Lower temperature → steadier, less creative RCA.
# OLLAMA_RCA_TEMPERATURE=0.3
# OLLAMA_RCA_TOP_P=0.9
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_RCA_MAX_LOG_CHARS=12000
# When true (default), /api/simulate-error + simulated JSON signals use a fixed Slack RCA (skip LLM). Set false to always use the model. Operator rerun text still forces the LLM.
# OLLAMA_RCA_SIMULATED_TEMPLATE_OVERRIDE=true
# Optional operator instructions on Slack/API RCA rerun (truncated to this length).
# OLLAMA_RCA_USER_PROMPT_MAX_CHARS=2000
# GET /api/tags preflight before /api/chat; set false to only require Ollama daemon up
OLLAMA_HEALTH_TIMEOUT_SECONDS=5
OLLAMA_HEALTH_REQUIRE_MODEL=true

# Optional escalation: OpenAI-compatible vendor API
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=

# Loki. Single instance: set LOKI_URL_DEFAULT only (leave PROD/NONPROD empty).
# Two instances: set LOKI_URL_PROD + LOKI_URL_NONPROD (optional LOKI_URL_DEFAULT when labels missing).
# LOKI_URL_PROD=https://loki-prod.example.internal
# LOKI_URL_NONPROD=https://loki-nonprod.example.internal
# LOKI_URL_DEFAULT=https://loki.example.internal
# LOKI_BEARER_TOKEN=
# Multi-tenant Loki (Grafana): same value as datasource "HTTP header" X-Scope-OrgID if used
# LOKI_SCOPE_ORG_ID=
# LOKI_ENRICH_ENABLED=true
# LOKI_ENRICH_WINDOW_MINUTES=10
# End of query_range: min(now, startsAt + after minutes) — avoids backward filling from "now" past the incident.
# LOKI_ENRICH_AFTER_START_MINUTES=5
# LOKI_ENRICH_ANCHOR=alert_start
# Use "now" to ignore Grafana startsAt and query ±window around webhook receipt time:
# LOKI_ENRICH_ANCHOR=now
# When Grafana startsAt is ahead of the agent clock (skew): true = tight window around startsAt + optional retries (see README). false = older behavior.
# LOKI_ENRICH_CLAMP_FUTURE_STARTS_AT=true
# Max skew (minutes) = startsAt − agent_now: only while skew ≤ this value may enrichment retry with a wide bridge window after an empty tight query (pairs with LOKI_ENRICH_RETRY_WIDE_SPAN_ON_EMPTY).
# LOKI_ENRICH_FUTURE_GAP_SPAN_MAX_MINUTES=180
# After an empty tight query, retry LogQL over a wide span from min(now,startsAt) to max(now,startsAt) (only if skew ≤ gap above and clamp is on).
# LOKI_ENRICH_RETRY_WIDE_SPAN_ON_EMPTY=true
# If still empty and startsAt > now+2m, retry with a bridge window (agent now ↔ Grafana startsAt).
# LOKI_ENRICH_EMPTY_FALLBACK_TO_NOW=true
# Within the cap (LOKI_RESULT_MAX_TOTAL_LINES), keep lines whose Loki timestamps are closest to Grafana startsAt — avoids backward newest-first filling the budget with post-incident noise.
# LOKI_ENRICH_PRIORITIZE_STARTS_AT=true
# Split the line cap: percent for index time *before* startsAt (lead-up); remainder after (recovery / tail). Unused slots spill to the other side.
# LOKI_ENRICH_STRATIFY_LINES=true
# LOKI_ENRICH_LINE_BUDGET_BEFORE_PCT=50
# Second query_range with LogQL |~ regex; merged (deduped) with the broad pass before line-cap normalize.
# LOKI_ENRICH_ERROR_PASS_ENABLED=true
# RE2 regex (Grafana/Loki); default catches error-level wording — tune per stack.
# LOKI_ENRICH_ERROR_LOGQL_REGEX=(?i)(error|exception|fatal|panic|warn)
# backward = newest first (default); forward = oldest first in window (often better for INFO→ERROR narrative)
# LOKI_QUERY_DIRECTION=backward
# LOKI_RESULT_MAX_TOTAL_LINES=100
# Lines requested per Loki query_range call (broad + error pass each use this).
# LOKI_QUERY_LIMIT=500

# Slack Incoming Webhook — heuristic digest + suggestions after each Grafana webhook (URLs redacted in snippets).
#SLACK_WEBHOOK_URL= <slack webhook url>
# Per-alert Slack/RCA without changing this: Grafana annotations ai_sre_notify_slack / ai_sre_ollama_rca,
# or webhook URL query slack_notify / ollama_rca — see README → Slack.
SLACK_NOTIFY_ENABLED=true
SLACK_TIMEOUT_SECONDS=10
# Slack Events API → POST /hooks/slack/events (thread replies: `rca <id>`). Signing Secret from the Slack app.
# SLACK_SIGNING_SECRET=
# Optional bot token — scope chat:write:bot for chat.postMessage thread replies (not Incoming Webhook).
# SLACK_BOT_TOKEN=
# Post full Incoming Webhook digest after RCA rerun (API or Slack thread); default false.
# NOTIFY_SLACK_ON_RCA_RERUN=false
# Default true: shorten operator checklist on DatasourceNoData, insufficient log labels, total Loki failures.
# SLACK_SMART_SKIP_OPERATOR_CHECKLIST=true

# Optional Cloudflare Tunnel — CLOUDFLARE_TUNNEL_ENABLED=true and CLOUDFLARE_TUNNEL_TOKEN (Zero Trust connector).
# CLOUDFLARE_TUNNEL_TOKEN=
